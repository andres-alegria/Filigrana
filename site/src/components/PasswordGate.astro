---
// Soft gate: the article body is never sent to the browser until the
// visitor's password hash matches. Not real security (see src/data/lock.ts)
// — enough to keep casual readers out of a few articles, nothing more.
interface Props {
  slug: string;
  lockHash: string;
}
const { slug, lockHash } = Astro.props;
---
<div class="gate" data-slug={slug} data-hash={lockHash}>
  <p>Por el momento, el acceso a este artículo es exclusivo para socios de la FFRH. Para más información sobre cómo formar parte de la FFRH, escribir a <a href="mailto:ffrh@hotmail.com">ffrh@hotmail.com</a>.</p>
  <form>
    <input type="password" placeholder="Contraseña" autocomplete="current-password" required />
    <button type="submit">Ver artículo</button>
  </form>
  <p class="err">Contraseña incorrecta. Intenta de nuevo.</p>
</div>
<div class="article-body" data-body-for={slug} hidden></div>

<script>
  async function sha256Hex(text: string) {
    const enc = new TextEncoder().encode(text);
    const buf = await crypto.subtle.digest('SHA-256', enc);
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  // Some browsers throw on any sessionStorage access at all (strict privacy
  // settings, certain private-browsing modes, some ad/tracker blockers) —
  // an unguarded call would abort the whole script before the submit
  // handler below ever gets attached, silently breaking the gate. Degrade
  // gracefully: unlocking just won't be "remembered" for the rest of the tab.
  function safeGet(key: string) {
    try { return sessionStorage.getItem(key); } catch { return null; }
  }
  function safeSet(key: string, value: string) {
    try { sessionStorage.setItem(key, value); } catch { /* ignore */ }
  }

  document.querySelectorAll<HTMLElement>('.gate').forEach((gate) => {
    const slug = gate.dataset.slug!;
    const hash = gate.dataset.hash!;
    const bodyEl = document.querySelector<HTMLElement>(`[data-body-for="${slug}"]`)!;
    const sessionKey = `filigrana-unlocked-${slug}`;

    async function reveal() {
      const res = await fetch(`/protected/${slug}.json`);
      const { html } = await res.json();
      bodyEl.innerHTML = html;
      bodyEl.hidden = false;
      gate.hidden = true;
    }

    if (safeGet(sessionKey) === '1') {
      reveal();
      return;
    }

    const form = gate.querySelector('form');
    // Belt-and-suspenders: some browser password-manager UIs (and some
    // in-app/embedded browsers) swallow the Enter keydown before it
    // triggers a form's implicit submission. Costs nothing when native
    // submission already fired on its own.
    form?.querySelector('input')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = gate.querySelector<HTMLInputElement>('input[type=password]')!;
      const attempt = await sha256Hex(input.value.trim());
      if (attempt === hash) {
        safeSet(sessionKey, '1');
        gate.classList.remove('err');
        await reveal();
      } else {
        gate.classList.add('err');
      }
    });
  });
</script>
