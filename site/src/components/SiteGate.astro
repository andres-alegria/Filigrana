---
// Soft, site-wide gate — same shared password as individual locked
// articles (src/data/lock.ts). Not real security: the page HTML is still
// delivered to any HTTP client (crawlers, curl, view-source), this just
// hides it from casual browser visitors until they enter the password.
// Meant for the "site is still being built" phase — remove this component
// from Layout.astro (and the <SiteGate /> call) once ready to go fully public.
import { LOCK_HASH } from '../data/lock';
---
<div id="site-gate" class="site-gate" data-hash={LOCK_HASH}>
  <div class="gate site-gate-box">
    <span class="wordmark"><span class="fil">Filigrana</span><span class="dot">.</span></span>
    <p>Este sitio está en construcción. El acceso es exclusivo para socios de la FFRH.</p>
    <form id="site-gate-form">
      <input type="password" placeholder="Contraseña" autocomplete="current-password" required />
      <button type="submit">Entrar</button>
    </form>
    <p class="err">Contraseña incorrecta. Intenta de nuevo.</p>
    <!-- Lets a visitor confirm what actually landed in the field — useful
         when a password manager autofills something unexpected. -->
    <button type="button" id="site-gate-peek" class="peek">Ver contraseña</button>
  </div>
</div>

<script>
  // NOTE: this is a normal (bundled, deferred) module script, not a
  // `define:vars` one. define:vars forces an inline *classic* script that
  // runs before the DOM is parsed and cannot use imports — the hash is
  // passed via the data-hash attribute instead.
  import { sha256Hex } from '../lib/sha256.js';

  const STORAGE_KEY = 'filigrana-site-unlocked';
  const gate = document.getElementById('site-gate');
  const siteBody = document.getElementById('site-body');
  const form = document.getElementById('site-gate-form');

  if (gate && siteBody && form) {
    const lockHash = gate.dataset.hash;
    // The "wrong password" message is shown by the `.gate.err .err` rule,
    // so the class has to go on the inner .gate box — not on #site-gate
    // (which carries .site-gate). Getting this wrong means a bad password
    // gives no feedback at all, which reads as "nothing happened".
    const box = gate.querySelector('.gate');

    // Some browsers throw on any localStorage access at all (strict privacy
    // settings, certain private-browsing modes, some ad/tracker blockers) —
    // an unguarded call would abort this script before the submit handler
    // below ever gets attached. Degrade gracefully: unlocking just won't be
    // "remembered" next visit.
    function safeGet(key) {
      try { return localStorage.getItem(key); } catch { return null; }
    }
    function safeSet(key, value) {
      try { localStorage.setItem(key, value); } catch { /* ignore */ }
    }

    function unlock() {
      gate.hidden = true;
      siteBody.hidden = false;
    }

    if (safeGet(STORAGE_KEY) === '1') {
      unlock();
    }

    const input = form.querySelector('input[type=password]');
    let checking = false;

    // The single place the password is actually checked. Every entry point
    // below calls this directly, so unlocking never depends on form
    // submission mechanics working a particular way.
    async function attemptUnlock() {
      if (checking) return;
      checking = true;
      try {
        const attempt = await sha256Hex(input.value.trim());
        if (attempt === lockHash) {
          safeSet(STORAGE_KEY, '1');
          box?.classList.remove('err');
          unlock();
        } else {
          box?.classList.add('err');
        }
      } catch (err) {
        console.error('Filigrana site gate: could not verify password', err);
        box?.classList.add('err');
      } finally {
        checking = false;
      }
    }

    // Three independent ways in, because relying on any single one has
    // already bitten us:
    //   1. form submit  — the normal path (button click, native Enter)
    //   2. Enter keydown — some browsers/password managers swallow the
    //      native implicit submission
    //   3. button click — last resort if submission is blocked entirely
    //
    // Crucially, none of these call form.requestSubmit(): that only exists
    // in Safari 16+, and calling it after preventDefault() means an older
    // browser cancels the native submit and then throws, so Enter silently
    // does nothing while the button still works.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      attemptUnlock();
    });

    input?.addEventListener('keydown', (e) => {
      // key/keyCode/code all checked: older browsers and some IME or
      // password-manager layers report Enter differently (or not at all).
      const isEnter = e.key === 'Enter' || e.keyCode === 13
        || e.code === 'Enter' || e.code === 'NumpadEnter';
      if (!isEnter) return;
      e.preventDefault();
      attemptUnlock();
    });

    form.querySelector('button')?.addEventListener('click', (e) => {
      e.preventDefault();
      attemptUnlock();
    });

    const peek = document.getElementById('site-gate-peek');
    peek?.addEventListener('click', () => {
      const showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      peek.textContent = showing ? 'Ver contraseña' : 'Ocultar contraseña';
      input.focus();
    });
  }
</script>
