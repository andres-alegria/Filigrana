---
interface Props {
  routeSlug: string;
  title: string;
  author: string;
  issueDate?: string | null; // YYYY-MM, original magazine publication
  publishDate: string; // YYYY-MM-DD, site debut
  summary?: string;
  locked?: boolean;
  coverSrc?: string | null;
}
const { routeSlug, title, author, issueDate, publishDate, summary, locked, coverSrc } = Astro.props;

const onlineLabel = new Date(publishDate + 'T00:00:00').toLocaleDateString('es-HN', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const originalLabel = issueDate
  ? new Date(issueDate + '-01T00:00:00').toLocaleDateString('es-HN', {
      year: 'numeric', month: 'long',
    })
  : null;
---
<a class="card" href={`/articulos/${routeSlug}/`}>
  <div class="thumb" aria-hidden="true">
    {coverSrc && <img src={coverSrc} alt="" loading="lazy" />}
  </div>
  <div class="body">
    <div class="byline">Por {author}</div>
    <h2>{title}</h2>
    {summary && <p class="dek">{summary}</p>}
    <div class="meta">
      {originalLabel && <span>Publicado originalmente: {originalLabel}</span>}
      <span>· En línea: {onlineLabel}</span>
      {locked && <span class="lockpill">🔒 Con contraseña</span>}
    </div>
  </div>
</a>
