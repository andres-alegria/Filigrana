---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ShareBar from '../components/ShareBar.astro';
import { publishQueue, isPublished, findEntry } from '../data/publish';
import { routeSlug } from '../lib/routing';
import { firstImageSrc } from '../lib/content';

const articles = await getCollection('articles');
// Featured entries lead, in their given rank; everything else follows newest
// first. See `featured` in data/publish.ts.
const rank = (p: { featured?: number }) => p.featured ?? Number.POSITIVE_INFINITY;
const latest = publishQueue
  .filter((p) => isPublished(p))
  .sort((a, b) => rank(a) - rank(b) || b.publishDate.localeCompare(a.publishDate))
  .slice(0, 5)
  .map((p) => ({ ...p, entry: findEntry(articles, p) }))
  .filter((p) => p.entry);
---
<Layout title="Inicio">
  <section class="hero">
    <canvas id="hero-canvas"></canvas>
    <div class="wrap">
      <span class="kicker">Honduras Filatélica · digital</span>
      <h1 class="wordmark hero-mark"><span class="fil">Filigrana</span><span class="dot">.</span><span class="tld">hn</span></h1>
      <p class="tag">Historia hondureña, revelada por sellos postales.</p>
      <ShareBar url="https://www.filigrana.hn/" title="Filigrana — el sello como puerta a la historia" />
      <div class="hairline"></div>
    </div>
  </section>

  <section class="wrap" style="padding:36px 0 60px">
    <h2 style="font-size:22px;margin-bottom:6px">Publicaciones recientes</h2>
    <div class="article-list">
      {latest.map(({ entry, publishDate, locked, teaser, type, coverAlign }) => (
        <ArticleCard
          routeSlug={routeSlug(entry!)}
          title={entry!.data.title_es}
          author={entry!.data.author}
          issueDate={entry!.data.issue_date}
          publishDate={publishDate}
          summary={teaser ?? entry!.data.summary_es}
          locked={locked}
          type={type}
          coverAlign={coverAlign}
          coverSrc={firstImageSrc(entry!.rendered?.html ?? '')}
        />
      ))}
    </div>
    {latest.length === 0 && (
      <p style="color:var(--ink-soft)">Aún no hay artículos publicados — vuelve pronto.</p>
    )}
    <p style="margin-top:24px"><a href="/articulos/" style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.1em;color:var(--green)">VER TODOS LOS ARTÍCULOS →</a></p>
  </section>
</Layout>

<script>
  import { guilloche, watchAndDraw } from '../lib/guilloche.js';

  function draw() {
    const c = document.getElementById('hero-canvas');
    if (!c) return;
    const cs = getComputedStyle(document.documentElement);
    const G = cs.getPropertyValue('--green').trim();
    const B = cs.getPropertyValue('--blue').trim();
    const Au = cs.getPropertyValue('--gold').trim();
    guilloche(c, {
      lw: 0.5, scale: 1.15,
      layers: [
        { R: 1, r: 0.34, d: 0.68, color: G, alpha: 0.24, turns: 50 },
        { R: 1, r: 0.3, d: 0.62, color: B, alpha: 0.16, turns: 50 },
        { R: 1, r: 0.233, d: 0.5, color: Au, alpha: 0.18, turns: 80 },
      ],
    });
  }
  const heroCanvas = document.getElementById('hero-canvas');
  if (heroCanvas) watchAndDraw(heroCanvas, draw);
</script>
