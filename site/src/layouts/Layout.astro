---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Filigrana — el sello como puerta a la historia.' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Filigrana</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#0d3b99" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=Archivo:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <!-- Cloudflare Web Analytics — cookie-free pageview tracking, no consent banner needed -->
  <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "533b56c3e659457c928b97c04b013405"}'></script>
</head>
<body>
  <header class="site">
    <div class="wrap row">
      <a href="/" style="text-decoration:none">
        <span class="wordmark"><span class="fil">Filigrana</span><span class="dot">.</span></span>
      </a>
      <nav class="site">
        <a href="/">Inicio</a>
        <a href="/articulos/">Artículos</a>
        <a href="/colecciones/">Colecciones</a>
        <a href="/sobre/">Sobre</a>
        <span class="lang-switch" aria-label="Idioma">
          <span class="lang-current" aria-current="true">ES</span>
          <span class="lang-sep">/</span>
          <span class="lang-soon" tabindex="0" title="Próximamente en inglés">EN</span>
        </span>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site">
    <div class="wrap colophon">
      <a class="fed-mark" href="/sobre/" aria-label="Federación Filatélica de la República de Honduras">
        <img src="/logo-ffrh.svg" alt="Federación Filatélica de la República de Honduras" width="120" height="36" loading="lazy" />
      </a>
      <canvas id="footer-canvas" class="footer-motif" aria-hidden="true"></canvas>
      <span>filigrana.hn</span>
    </div>
  </footer>

  <script>
    import { guilloche, watchAndDraw } from '../lib/guilloche.js';

    function drawFooterMotif() {
      const c = document.getElementById('footer-canvas');
      if (!c) return;
      const cs = getComputedStyle(document.documentElement);
      const G = cs.getPropertyValue('--green').trim();
      const Au = cs.getPropertyValue('--gold').trim();
      guilloche(c, {
        lw: 0.6, scale: 0.92,
        layers: [
          { R: 1, r: 0.34, d: 0.68, color: G, alpha: 0.5, turns: 50 },
          { R: 1, r: 0.233, d: 0.5, color: Au, alpha: 0.4, turns: 80 },
        ],
      });
    }
    const footerCanvas = document.getElementById('footer-canvas');
    if (footerCanvas) watchAndDraw(footerCanvas, drawFooterMotif);
  </script>
</body>
</html>
