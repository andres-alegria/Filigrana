# --- Heavy / copyrighted source material (kept local, never pushed) ---
# The 24 magazine editions (.doc/.docx). Source for the content pipeline;
# too large for git and rights not yet cleared for publication.
Filatelia/

# Moodboard source images (originals feeding the design; the final
# moodboard HTML embeds only what it needs).
_moodboard_src/

# Extracted magazine images — derived from the (git-ignored) source docx
# and fully regenerable by the pipeline. Copyrighted; kept local for now.
content/_assets/

# --- OS / editor cruft ---
.DS_Store
*.swp
Thumbs.db

# --- Node / build (for when the Astro site is scaffolded) ---
node_modules/
dist/
.astro/
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc

# Design reference images (inspiration; some stock/copyrighted) — local only
Intaglio/

# Generated social assets — regenerable from pipeline/build_social.py
social/

# --- Stray artefacts from the docx→Markdown conversion ---
# Loose extracted images, R session logs, and intermediate HTML dumps that
# land next to the content but are not part of it.
.Rhistory
content/*.png
content/**/*.html
